rules_version = '2';

// 새록새록 — Firestore 보안 규칙
// Firebase 콘솔 → Firestore Database → 규칙(Rules) 탭에 그대로 붙여넣고 "게시".
//
// 원칙
// - 아이 하늘(children/{childId})은 ID(초대 코드)를 아는 사람만 열 수 있다.
// - 전체 목록 조회는 막는다 → 남의 코드를 훑어볼 방법이 없다.
// - 기록은 형식이 맞을 때만 저장된다.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    match /children/{childId} {
      // 아이 이름(필수)과 출생 연월 'YYYY-MM'(선택)
      function validChild() {
        let d = request.resource.data;
        return d.name is string && d.name.size() > 0 && d.name.size() <= 40
          && (!('birth' in d) || (d.birth is string && d.birth.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')));
      }
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && childId.size() == 20 && validChild();
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'birth'])
        && validChild();
      allow delete: if false;

      function childExists() {
        return exists(/databases/$(database)/documents/children/$(childId));
      }

      // 가족 한 사람 { nickname, joinedAt }
      match /members/{memberId} {
        allow read: if signedIn() && childExists();
        allow create, update: if signedIn() && childExists()
          && memberId.size() <= 40
          && request.resource.data.keys().hasOnly(['nickname', 'joinedAt'])
          && request.resource.data.nickname is string
          && request.resource.data.nickname.size() > 0
          && request.resource.data.nickname.size() <= 20;
        allow delete: if false;
      }

      // 기록 — 문서 이름은 '날짜_구성원ID' (한 사람당 하루 하나)
      // 예전 구조(문서 이름이 날짜)는 새 구조로 옮긴 뒤 지울 수만 있다.
      match /entries/{entryId} {
        function validEntry() {
          let d = request.resource.data;
          return d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
            && d.memberId is string && d.memberId.size() > 0 && d.memberId.size() <= 40
            && entryId == d.date + '_' + d.memberId
            && d.text is string && d.text.size() > 0 && d.text.size() <= 1000
            && d.level in ['pisik', 'mungkeul', 'forever']
            && (!('note' in d) || (d.note is string && d.note.size() <= 300))
            && (!('author' in d) || (d.author is string && d.author.size() <= 20));
        }
        allow read: if signedIn() && childExists();
        allow create, update: if signedIn() && childExists() && validEntry();
        allow delete: if signedIn() && childExists();
      }
    }
  }
}
